# Relay controlled-trial environment
# Reference for shell/hosting configuration. Never commit real credentials or participant data.

# development | test | staging | production
# Staging and production both enforce HTTPS, PostgreSQL, Redis, SMTP, trusted
# proxy counts, a strong secret, and the exact invite-only trial contract.
RELAY_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Keep at INFO: the structured
# per-request and auth-event lines are emitted at INFO, so anything higher
# silently discards the request audit trail.
RELAY_LOG_LEVEL=INFO

# Required in production. Generate a high-entropy value outside source control.
# Production rejects this placeholder and values shorter than 32 characters.
RELAY_SECRET_KEY=replace-with-a-random-secret

# Required HTTPS origin in production; used for email links rather than request Host headers.
RELAY_PUBLIC_URL=http://localhost:8000
RELAY_TRUSTED_HOSTS=localhost

# Number of reverse proxies that set each forwarded header. Keep all at 0 for
# direct local development. Production requires every value to be explicit and
# X_FOR/X_PROTO to be positive. Keep X_HOST at 0 unless the deployed proxy is
# confirmed to rewrite that header. Incorrect counts can trust attacker input.
RELAY_PROXY_X_FOR=0
RELAY_PROXY_X_PROTO=0
RELAY_PROXY_X_HOST=0

# Development may use SQLite. Production requires an explicit psycopg PostgreSQL URL,
# for example postgresql+psycopg://USER:PASSWORD@HOST/DATABASE. Apply reviewed
# migrations separately; application startup never changes the schema.
DATABASE_URL=
PORT=8000

# Controlled-trial contract: exactly one category and one credit per 30-minute session.
# Production refuses to boot if the category is absent or set to "all".
RELAY_TRIAL_CATEGORY=creative
# Trial configuration accepts 1–10; the controlled default is 2.
RELAY_STARTER_CREDITS=2
RELAY_ALLOWED_EMAIL_DOMAINS=nyu.edu

# Production is invite-only and fails closed outside the exact 10–20 participant contract.
# Use lowercase, comma-separated institutional addresses; never commit the real list.
RELAY_REQUIRE_INVITE=false
# Production requires 10–20 unique, validated addresses. Supply only through the
# hosting secret UI; never commit the cohort list.
RELAY_INVITED_EMAILS=

# Development/test stores messages in the in-process test outbox without printing secrets.
# Production requires smtp plus host and sender settings.
RELAY_EMAIL_BACKEND=memory
RELAY_SMTP_HOST=
RELAY_SMTP_PORT=587
RELAY_SMTP_USERNAME=
RELAY_SMTP_PASSWORD=
RELAY_EMAIL_FROM=

# Production requires shared storage such as redis://...; memory:// is local-only.
RATE_LIMIT_STORAGE=memory://

# Set only in the authenticated scheduler job, never on the public web service.
RELAY_SCHEDULER_AUTHENTICATED=false

# Synthetic fixture creation is restricted to test/staging, dry-run by default, and
# requires both explicit authorization and a non-committed strong password.
RELAY_REHEARSAL_DATA_AUTHORIZED=false
RELAY_REHEARSAL_PASSWORD=

# Exact HTTPS meeting hosts accepted from teachers. Host substring matches are never used.
RELAY_ALLOWED_MEETING_HOSTS=nyu.zoom.us,zoom.us,meet.google.com,teams.microsoft.com

# Public support address shown in the app. Naming the staffed operator is a launch blocker.
RELAY_CONTACT_EMAIL=hello@joinrelay.co
